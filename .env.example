# Environment variables. Copy to .env.local for local development (never commit .env.local).
# .env.local points to the DEVELOPMENT Supabase project; `pnpm harness preview` checks it before every test.
# Production values live only in the web host (not decided yet) and in Fly.io secrets per worker app
# (`fly secrets set ... --app <worker>`), set by a human. No local Supabase stack is needed. The workers run as containers on the development
# VM; compose.dev.yaml passes this file (read on your Mac) to them with env_file.
# Scope tags: [public] reaches the browser (NEXT_PUBLIC_ prefix), [server] web server only,
# [workers] the workers that need it (in brackets), [both] web server and workers.

# ---- Supabase (development project) ----
# [public] https://<dev-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# [public] Publishable key (older projects: anon key)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# [both] Secret key (older projects: service_role). Web: only src/server/supabase/admin.ts. Workers: Storage access.
SUPABASE_SECRET_KEY=
# [both] Postgres connection string of the DEVELOPMENT project for pg-boss (web enqueues, workers consume).
# Use a dedicated worker role, not the postgres superuser.
DATABASE_URL=
# [public] Canonical site URL for auth redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- AI ----
# [workers: agent] Claude through the Claude Agent SDK
ANTHROPIC_API_KEY=
# [workers: agent] Video generation: the active provider is chosen in Settings (provider_settings)
GOOGLE_VEO_API_KEY=
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
# [workers: agent] Voiceover
ELEVENLABS_API_KEY=

# ---- Discovery ----
# [workers: discovery] Instagram and TikTok data provider (default Apify)
APIFY_TOKEN=
# [workers: discovery] YouTube Data API v3
YOUTUBE_API_KEY=

# ---- Meta (publishing, ads, insights) ----
# [workers: publish, analytics] App credentials. User and page tokens are NOT here: they live in Supabase Vault.
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=

# ---- Runtime ----
# [workers: all] Which queues a local or deployed process consumes (comma separated); empty means its own worker
WORKER_QUEUES=
# [both] Time zone shown to users
APP_TIMEZONE=Europe/Madrid
